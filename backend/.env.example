# Entorno de ejecución (development, test, production)
NODE_ENV=development

# Puerto del servidor API backend
PORT=4000

# Secreto JWT (Obligatorio en producción sin modo efímero; en desarrollo o demo efímera se genera aleatorio si se omite)
# JWT_SECRET=

# Dominios permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Directorio raíz de almacenamiento (relativo a backend)
# STORAGE_DIR=./storage

# Ruta específica del archivo SQLite
# DB_PATH=./storage/data.db

# Directorio de almacenamiento de PDF de proformas
# PROFORMA_DIR=./storage/proformas

# Directorio de respaldos SQLite
# BACKUP_DIR=./storage/backups

# --- MODO DEMOSTRACIÓN EFÍMERO (Para despliegue gratuito sin persistencia) ---
# Requiere obligatoriamente que las tres variables sean exactamente "true" para activarse.
# Si están inactivas o incompletas, el backend opera en modo normal seguro sin auto-seeding.
# En modo efímero:
# 1. La base de datos y archivos se almacenan bajo el directorio temporal del SO (os.tmpdir()).
# 2. Si la base temporal está vacía al iniciar, se ejecuta un seeder con datos sintéticos.
# 3. No se requiere volumen persistente (DB_PATH / STORAGE_DIR).
# DEMO_MODE=false
# DEMO_EPHEMERAL=false
# ALLOW_DEMO_AUTO_SEED=false

# Configuración opcional de cuenta administradora inicial
# ADMIN_EMAIL=demo.admin@portfolio.invalid
# ADMIN_PASSWORD=

# Configuración opcional de servidor de correo SMTP para envío de proformas
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=usuario@example.com
# SMTP_PASS=
# SMTP_FROM=soporte@example.com
