# Ejemplo de configuración de variables de entorno para desarrollo local y demostración
# NUNCA ingresar valores reales, secretos productivos ni rutas de datos reales en este archivo.

# --- BACKEND ---
NODE_ENV=development
PORT=4000
# JWT_SECRET=
CORS_ORIGIN=http://localhost:5173

# Ubicaciones de almacenamiento persistente (relativas o genéricas para desarrollo local)
# STORAGE_DIR=./storage
# DB_PATH=./storage/data.db
# PROFORMA_DIR=./storage/proformas
# BACKUP_DIR=./storage/backups

# --- MODO DEMOSTRACIÓN EFÍMERO (Para despliegue gratuito sin persistencia) ---
# Requiere obligatoriamente que las tres variables sean exactamente "true" para activarse.
# Si están ausentes, incompletas o en "false", el backend opera en modo normal seguro.
# En modo efímero:
# 1. La base de datos y archivos se ubican bajo el directorio temporal del SO (os.tmpdir()).
# 2. Si la base temporal está vacía al iniciar, se ejecuta un seeder con datos sintéticos.
# 3. No se requiere volumen persistente (DB_PATH / STORAGE_DIR).
# DEMO_MODE=false
# DEMO_EPHEMERAL=false
# ALLOW_DEMO_AUTO_SEED=false

# --- FRONTEND (Vite) ---
# VITE_API_BASE_URL=http://localhost:4000
# VITE_DEMO_MODE=false
# VITE_DEMO_EPHEMERAL=false
